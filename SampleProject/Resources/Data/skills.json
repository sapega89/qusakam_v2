{
  "_schema": {
    "description": "Skill definitions read by SkillDatabase. Kusakam's skills (D141, D148); learn with skill points (D149, one per level D279), upgrade to rank 20 (D150). Effects D207. Trees and the class path D260, D279-D285 (design/skill_trees_plan.md). Numbers are mock. Skill power scales with the hero's attack (B137), SP comes from hits and parries and cooldowns stay only on ultimates (D504), Healing Palm is a flask (D504), each oath ends on an active ultimate (D491), synergies and conditional passives (D496), a JP cap per tree and base-tree gates for profession skills (D497).",
    "entry": {
      "id": "String, required, unique",
      "name": "String",
      "description": "String",
      "class_id": "String - matches pathfinder_classes.json; empty means any class",
      "subclass_id": "String",
      "skill_type": "active | passive",
      "jp_cost": "int >= 0 - Job Points spent to unlock",
      "required_level": "int >= 1 - XPManager level gate",
      "prerequisites": "[skill_id] - must be unlocked first",
      "sp_cost": "int >= 0 - active only, forced to 0 for passive; SP comes from landed hits and parries (D504)",
      "cooldown": "float >= 0 seconds - active only, forced to 0 for passive; only ultimates have one (D504)",
      "icon": "res:// path",
      "vfx": "res:// .tscn of the cast effect (SkillCastFX: 'charge' during the wind-up, 'release' on completion) - active only (D271)",
      "heal": "int >= 0 - HP restored on the target (D142: an ally next to the hero, else the hero)",
      "damage": "int >= 0 - damage to everything in front of the hero (D142)",
      "required_weapons": "[equipment slot] - usable only while one of these slots holds a weapon (D141)",
      "burn": "{dps: int, duration: float} - sets the target burning (D207); a new burn refreshes",
      "chain": "{radius: px, ratio: 0..1} - also hits the nearest other enemy within radius of the first target (D207)",
      "stun": "float seconds - stuns the first target; cancels a wind-up in progress (D207)",
      "passive": "{stat: max_health | shield_block | max_sp | attack | damage_reduction | heal_power | sp_per_hit | lifesteal | poise | skill_damage, value, condition?: {type: below_hp (value = HP fraction) | after_parry | after_skill (value = seconds)}} - passive only (D207, D284, D496); a conditional passive counts only while its condition holds",
      "cast": "{windup: s, release: s, pose: Player.tscn animation prefix (<pose>Windup / <pose>Release)} - active only, required; a stagger during the wind-up interrupts (D259, D271)",
      "oath": "String - the tree: \"\" = Holy Warrior trunk (everyone), else an id in oaths; such a skill needs that oath sworn (D280)",
      "damage_scaling": "{phys: float, elem: float} - adds that share of the hero's Phys. Atk. / Elem. Atk. to damage (B137)",
      "heal_scaling": "{phys: float, elem: float} - adds that share of the hero's Phys. Atk. / Elem. Atk. to heal (B137)",
      "ultimate": "bool - the oath's level-20 active ultimate: long cooldown, screen shake, double gold ring on the hotbar (D491, D453)",
      "charges": "int >= 0 - a flask: uses charges instead of SP, refilled when the game is saved at a save point (D504); 0 = not a flask",
      "synergies": "[{skill: passive id of the same tree, per_rank: fraction}] - each rank of that passive adds per_rank to this skill's damage and heal (D496)",
      "base_jp": "int >= 0 - JP that must be spent in the base class tree before this profession skill can be learned (D497)"
    },
    "class": "{name, jp_cap} - the trunk's class title before an oath (D260); jp_cap = JP that can be spent in the trunk (D497)",
    "oaths": "{<oath_id>: {name, tree: Light | Dark | Neutral, level: int, jp_cap: int, keeper, subclasses: [String], prestige: String}} - sworn once at the keeper NPC (D280, D281); jp_cap = JP that can be spent in this tree (D497); subclasses (level 40) and prestige (level 70) are names only, not built"
  },
