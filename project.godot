; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

metroidvania_system/settings_file="uid://po1yy1ihchuv"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="New Game Project"
run/main_scene="res://SampleProject/MainMenu.tscn"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://b8wr0hwoqop4v"
general/default_playback_type.web=0
general/text_to_speech=true
driver/driver=""

[autoload]

MetSys="*res://addons/MetroidvaniaSystem/Nodes/Singleton.tscn"
GameManager="*res://SampleProject/Scenes/Managers/Core/GameManager.tscn"
EventBus="*res://SampleProject/Scenes/EventBus.tscn"
SaveSystem="*res://SampleProject/Scenes/Systems/SaveSystem.tscn"
ServiceLocator="*res://SampleProject/Scenes/ServiceLocator.tscn"
AudioManager="*res://SampleProject/Scenes/Systems/AudioManager.tscn"
DisplayManager="*res://SampleProject/Scenes/Systems/DisplayManager.tscn"
ItemDatabase="*res://SampleProject/Scenes/Systems/ItemDatabase.tscn"
SkillDatabase="*res://SampleProject/Scripts/Systems/SkillDatabase.gd"
LocalizationManager="*res://SampleProject/Scenes/Systems/LocalizationManager.tscn"
ModalDialogGlobal="*res://addons/ModalDialog/scenes/globals/modal_dialog_global.tscn"
AppConfig="*res://SampleProject/Scripts/Systems/InputConfig.gd"
SceneLoader="*res://addons/maaacks_menus_template/base/nodes/autoloads/scene_loader/scene_loader.tscn"
ProjectMusicController="*res://addons/maaacks_menus_template/base/nodes/autoloads/music_controller/project_music_controller.tscn"
ProjectUISoundController="*res://addons/maaacks_menus_template/base/nodes/autoloads/ui_sound_controller/project_ui_sound_controller.tscn"
DialogueQuest="*uid://dt3pmybyly12b"

[dialogue_quest]

data_directory=&"res://dialogue_quest/"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/CustomRunner/plugin.cfg", "res://addons/MetroidvaniaSystem/EditorExtension/plugin.cfg", "res://addons/MetroidvaniaSystem/plugin.cfg", "res://addons/ModalDialog/plugin.cfg", "res://addons/dialogue_quest/plugin.cfg", "res://addons/maaacks_menus_template/plugin.cfg")

[global_script_class]

UIState="res://SampleProject/Scripts/UI/States/ui_state.gd"

